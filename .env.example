# botready.dev environment. Copy to .env.local for the web app; set on Railway
# for the worker. Nothing here is optional in production except where noted.

# ---------------------------------------------------------------- supabase
SUPABASE_URL=https://xxxx.supabase.co
# Either key format works. The legacy names are SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY; the newer dashboard exports SUPABASE_PUBLISHABLE_KEY
# (sb_publishable_…) and SUPABASE_SECRET_KEY (sb_secret_…), and the app accepts
# those names too.
SUPABASE_ANON_KEY=
# Bypasses row level security. The web app uses it to insert scans and grant
# entitlements. Never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# The worker connects with postgres.js. Use the SESSION pooler (port 5432 on
# the pooler host), not the transaction pooler: the worker holds a long-lived
# connection and the transaction pooler drops prepared statements under it.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- upstash
# Redis: per-IP rate limit and the 24h result cache. The app degrades open
# without them (no limit, no cache), so they are required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# QStash: the web app publishes scan jobs, the worker verifies the signature.
# Without QSTASH_TOKEN the web app posts straight to the worker, which the
# worker accepts outside production only.
QSTASH_TOKEN=
# Tokens are regional. Copy QSTASH_URL from the same console page as the token;
# without it the client talks to qstash.upstash.io and a regional token 404s.
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------------------------------------------------------------- the worker
# https URL of the Railway service.
SCANNER_URL=https://botready-scanner.up.railway.app
# The worker rejects any request without this header. Generate with
# `openssl rand -hex 32` and set it on both sides.
SCANNER_SHARED_SECRET=
# Worker-only. How many scans may run at once. Small: each holds a browser tab.
SCANNER_CONCURRENCY=2

# ---------------------------------------------------------------- stripe
# The webhook needs both of these whichever way people pay: it verifies the
# signature and grants the entitlement.
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
# Two ways to charge, and the payment links win when they are set.
#
# 1. Payment links. Stripe hosts the page; we redirect to it with the scan or
#    site id as client_reference_id, and the webhook reads that back. The live
#    links are the defaults in apps/web/lib/site.ts, because a payment link is
#    a public URL. Set these only to point a build at test-mode links.
# STRIPE_LINK_FIXPACK=https://buy.stripe.com/…
# STRIPE_LINK_MONITOR=https://buy.stripe.com/…
#
# 2. Checkout Sessions built here from price ids, used when no link resolves.
#    Price ids, not product ids.
STRIPE_PRICE_FIXPACK=price_
STRIPE_PRICE_MONITOR=price_

# ---------------------------------------------------------------- email
RESEND_API_KEY=

# ---------------------------------------------------------------- model
# Report prose only. Never anything factual. Optional: without it the punch
# list ships with its template rationale, which is already good.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- vercel
# Vercel sends this as a bearer token to the cron routes. Set it in the
# project's environment; Vercel generates one when you add a cron.
CRON_SECRET=
# Where the site believes it lives, for absolute URLs in share cards and email.
NEXT_PUBLIC_SITE_ORIGIN=https://botready.dev

# ---------------------------------------------------------------- development only
# Both are ignored outright when NODE_ENV is production, and a test asserts it.
# Let the scan tests reach their own loopback fixture, which the SSRF guard
# exists to refuse. Comma-separated host:port.
# SCANNER_ALLOW_PRIVATE_HOSTS=127.0.0.1:8123
# Override the one-second gap between requests. The tests set this to 0.
# SCANNER_PAGE_DELAY_MS=0
