node_modules/
.next/
dist/
out/
.turbo/
coverage/
*.tsbuildinfo
# Every env file, at any depth, whatever it is called. The three patterns here
# before covered .env and .env.local but not .env.production, .env.development
# or .env.test — which Next.js reads natively, so they are files people really
# create and really fill with real values. One catch-all and one exception is
# the only form of this rule that cannot be outgrown.
.env*
!.env.example
.DS_Store
.vercel
test-results/
playwright-report/

# Intermediate frames from scripts/build-icons.mjs; the packed .ico is committed.
apps/web/assets/icon/.ico-*.png
# Design previews render here; build output, not source.
tools/design-out/

# Launch video. The renders and the raw captures are build output, like
# marketing/assets/out: `pnpm video:capture && video:titles && video:build`
# regenerates them from the app. The shot manifests are kept, because they
# record the framing decisions, and vo/ is kept because regenerating it spends
# credits at a text-to-speech API rather than CPU.
marketing/video/out/
tools/design-out/
marketing/video/footage/*.mp4
marketing/video/titles/*.mp4
marketing/video/cards/*.png
